<Window x:Class="Symlinker.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:Symlinker.Properties"
    Title="{x:Static p:Resources.AboutButton}"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MahApps.Brushes.Gray10}">
    <Grid Margin="22,20,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="icon.ico" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Symlinker" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="versionText" Margin="0,2,0,0"
                           Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,18">
            <TextBlock Text="{x:Static p:Resources.AboutDescription}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                       Text="{x:Static p:Resources.AboutCredits}"/>
            <TextBlock Margin="0,12,0,0">
                <Run Text="{x:Static p:Resources.AboutProject}"/><Run Text=": "/><Hyperlink x:Name="githubLink" RequestNavigate="Link_RequestNavigate">GitHub</Hyperlink><Run Text="  ·  "/><Hyperlink x:Name="giteeLink" RequestNavigate="Link_RequestNavigate">Gitee</Hyperlink>
            </TextBlock>

            <!-- UPDATES -->
            <Separator Margin="0,16,0,12"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="checkButton" Content="{x:Static p:Resources.AboutCheckUpdates}" Click="CheckUpdates_Click"/>
                <TextBlock x:Name="updateStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="downloadRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Hyperlink x:Name="downloadLink" RequestNavigate="Link_RequestNavigate">
                    <Run Text="{x:Static p:Resources.UpdateDownload}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="2" Content="{x:Static p:Resources.Ok}" IsDefault="True" IsCancel="True"
                MinWidth="84" HorizontalAlignment="Right"/>
    </Grid>
</Window>

<Window x:Class="Symlinker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Symlinker"
    xmlns:p="clr-namespace:Symlinker.Properties"
    Title="Symlinker"
    Width="1120" Height="780"
    MinWidth="900" MinHeight="620"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Icon="icon.ico"
    Background="{DynamicResource MahApps.Brushes.Gray10}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Trees always show everything expanded -->
        <Style x:Key="ExpandedTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource MahApps.Styles.TreeViewItem}">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <!-- A group = a parent folder -->
        <HierarchicalDataTemplate DataType="{x:Type local:PathGroup}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayHeader}" FontWeight="SemiBold"/>
        </HierarchicalDataTemplate>

        <!-- A leaf = one file, or one folder treated as a single item -->
        <DataTemplate DataType="{x:Type local:PathLeaf}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial.Style>
                        <Style TargetType="iconPacks:PackIconMaterial">
                            <Setter Property="Kind" Value="FileOutline"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                    <Setter Property="Kind" Value="FolderOutline"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Missing">
                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconMaterial.Style>
                </iconPacks:PackIconMaterial>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Foreground" Value="#D13438"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{x:Static p:Resources.MissingSuffix}" Foreground="#D13438" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="contentGrid" Margin="16,10,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FAVORITES -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static p:Resources.Favorites}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="setCombo" Grid.Column="1" IsEditable="True" DisplayMemberPath="Name"
                      SelectionChanged="SetCombo_SelectionChanged"/>
            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="72" Content="{x:Static p:Resources.Save}" Click="SaveSet_Click"/>
            <Button Grid.Column="3" Margin="6,0,0,0" MinWidth="72" Content="{x:Static p:Resources.Delete}" Click="DeleteSet_Click"/>
            <Grid Grid.Column="4" Margin="22,0,0,0">
                <Button x:Name="aboutButton" MinWidth="72" Content="{x:Static p:Resources.AboutButton}" Click="About_Click"/>
                <Ellipse x:Name="updateBadge" Width="12" Height="12" Fill="#E81123"
                         Stroke="{DynamicResource MahApps.Brushes.Gray10}" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                         IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- TWO PANES -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: where the links are created -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{x:Static p:Resources.LeftTitle}"/>
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <Button Tag="left" Content="{x:Static p:Resources.AddFolders}" Click="AddFolders_Click" Margin="0,0,6,4"/>
                    <Button Tag="left" Content="{x:Static p:Resources.Edit}" Click="Edit_Click" Margin="0,0,6,4"/>
                    <Button Tag="left" Content="{x:Static p:Resources.Replace}" Click="Replace_Click" Margin="0,0,6,4"/>
                    <Button Tag="left" Content="{x:Static p:Resources.Delete}" Click="Delete_Click" Margin="0,0,6,4"/>
                    <Button Tag="left" Content="{x:Static p:Resources.Clear}" Click="Clear_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <Border Grid.Row="2" Tag="left"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource MahApps.Brushes.Control.Background}" AllowDrop="True"
                        PreviewDragEnter="Pane_DragOver" PreviewDragOver="Pane_DragOver" Drop="Pane_Drop">
                    <TreeView x:Name="leftTree" Tag="left" BorderThickness="0" Margin="4"
                              ItemContainerStyle="{StaticResource ExpandedTreeItem}"
                              KeyDown="Tree_KeyDown"/>
                </Border>
            </Grid>

            <!-- RIGHT: the real files and folders -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{x:Static p:Resources.RightTitle}"/>
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <Button Tag="right" Content="{x:Static p:Resources.AddFolders}" Click="AddFolders_Click" Margin="0,0,6,4"/>
                    <Button Tag="right" Content="{x:Static p:Resources.AddFiles}" Click="AddFiles_Click" Margin="0,0,6,4"/>
                    <Button Tag="right" Content="{x:Static p:Resources.Edit}" Click="Edit_Click" Margin="0,0,6,4"/>
                    <Button Tag="right" Content="{x:Static p:Resources.Replace}" Click="Replace_Click" Margin="0,0,6,4"/>
                    <Button Tag="right" Content="{x:Static p:Resources.Delete}" Click="Delete_Click" Margin="0,0,6,4"/>
                    <Button Tag="right" Content="{x:Static p:Resources.Clear}" Click="Clear_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <Border Grid.Row="2" Tag="right"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource MahApps.Brushes.Control.Background}" AllowDrop="True"
                        PreviewDragEnter="Pane_DragOver" PreviewDragOver="Pane_DragOver" Drop="Pane_Drop">
                    <TreeView x:Name="rightTree" Tag="right" BorderThickness="0" Margin="4"
                              ItemContainerStyle="{StaticResource ExpandedTreeItem}"
                              KeyDown="Tree_KeyDown"/>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="hintText" Grid.Row="2" Margin="0,6,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                   Text="{x:Static p:Resources.Hint}"/>

        <!-- OPTIONS -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                <TextBlock Text="{x:Static p:Resources.PairingLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="pairingCombo" Width="400" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="Pairing_SelectionChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                <TextBlock Text="{x:Static p:Resources.LinkType}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="modeCombo" Width="330" DisplayMemberPath="Text" SelectedValuePath="Value"
                          SelectionChanged="Mode_SelectionChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                <TextBlock Text="{x:Static p:Resources.OnExists}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="policyCombo" Width="170" DisplayMemberPath="Text" SelectedValuePath="Value"/>
            </StackPanel>
            <Button Margin="0,0,0,6" Content="{x:Static p:Resources.Refresh}" Click="Refresh_Click"/>
        </WrapPanel>

        <!-- PLAN -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="planSummary" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel x:Name="pairBar" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                <Button Content="{x:Static p:Resources.PairSelected}" Click="PairSelected_Click"
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Padding="14,4"/>
                <Button Content="{x:Static p:Resources.PairRemove}" Click="PairRemove_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="planGrid" Grid.Row="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                            <Setter Property="Foreground" Value="#D13438"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static p:Resources.ColLink}" Binding="{Binding LinkPath, Mode=OneWay}" Width="1.4*"/>
                <DataGridTextColumn Header="{x:Static p:Resources.ColSource}" Binding="{Binding Source, Mode=OneWay}" Width="1.4*"/>
                <DataGridTextColumn Header="{x:Static p:Resources.ColKind}" Binding="{Binding KindText, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="{x:Static p:Resources.ColStatus}" Binding="{Binding StatusText, Mode=OneWay}" Width="170"/>
                <DataGridTextColumn Header="{x:Static p:Resources.ColResult}" Binding="{Binding ResultText, Mode=OneWay}" Width="1.1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- RUN -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="summaryText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,12,0" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
            <Button x:Name="runButton" Grid.Column="1" Padding="26,9"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Content="{x:Static p:Resources.RunAll}" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
